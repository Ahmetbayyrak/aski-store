rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      // Sadece senin kullanıcın yazabilir. UID'yi Authentication → Users sayfasından kopyala.
      allow write: if request.auth != null && request.auth.uid == "ADMIN_UID_BURAYA";
    }
  }
}
